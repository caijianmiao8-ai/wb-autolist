{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WB AutoList",
  "version": "1.0.37",
  "identifier": "com.wbautolist.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "npm run fe:dev",
    "beforeBuildCommand": "npm run fe:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WB AutoList",
        "width": 1280,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#09080f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/caijianmiao8-ai/wb-autolist/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDRUNBQTlERDg1NzE4MzMKUldRekdGZlluYXJzZkc4NWd6UVBMNDJwVlA4NWpXT2NXNHlZOWg0eEVIMnhMK1BVVXRoWkF1a0YK",
      "windows": { "installMode": "quiet" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../tools/dub/*.mjs": "tools/dub/",
      "../tools/dub/*.py": "tools/dub/",
      "../tools/dub/providers/*.mjs": "tools/dub/providers/",
      "binaries/*": "bin/"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
