# ─────────────────────────────────────────────────────────────
# WB AutoList 配置示例 —— 复制为 .env.local（gitignored）注入密钥。
# 密钥优先用环境变量注入，不要提交/随交付物分发。
# ─────────────────────────────────────────────────────────────

# 访问密码：设置后全站(页面+API)需 HTTP Basic Auth(用户名任意，密码为此值)。
# 仅本机 localhost 开发可留空；任何非本机/公网部署务必设置，否则任何人可用你的
# Token 上架/改价/刷爆 AI 额度。
APP_PASSWORD=

# Wildberries 卖家 API Token（设置页 -> Контент 类目，新 Token）
# 真上架必填；留空则只能跑「草稿/演示」模式
WB_CONTENT_TOKEN=

# 如果价格 Token 与内容 Token 分开签发，填这里；留空则复用 WB_CONTENT_TOKEN
WB_PRICES_TOKEN=

# 沙盒环境（测试 Token "t":true 必须开启）：true 走 content-api-sandbox.wildberries.ru
WB_SANDBOX=

# 文生图提供方：aurixel(推荐) | pollinations(免key) | openai
IMAGE_PROVIDER=pollinations

# Aurixel API Key（ck_...，OpenAI 兼容网关，gpt-image-2，推荐）
AURIXEL_API_KEY=

# Aurixel 文案模型（聊天）：gpt-5.5(默认) | gpt-4o | claude-opus-4-8 ...
AURIXEL_CHAT_MODEL=gpt-5.5

# ElevenLabs API Key（sk_...）—— 视频英配→俄配流水线：Scribe 转写(ASR) + 俄语 TTS
# 受限 key 可用 TTS/STT/Dubbing；克隆与配额读取(user_read)不可用；Dubbing 仅带水印
ELEVENLABS_API_KEY=

# Qwen / DashScope Key（sk-...）—— qwen3-tts-vc 音色克隆配音(--tts-provider qwen-vc)
# 可克隆原视频说话人音色再说俄语。注意 key 锁区(北京 dashscope.aliyuncs.com)
QWEN_API_KEY=

# 仅当 IMAGE_PROVIDER=openai 时需要
OPENAI_API_KEY=

# Pollinations Token（可选，免费注册 auth.pollinations.ai，解除匿名限流/水印）
# 未配置时免费层可能被限流，应用会自动用品牌占位图兜底
POLLINATIONS_TOKEN=

# 文案由 Aurixel 的 key + 上面选的「文案模型」生成（无独立 LLM 配置）。

# 应用对外可访问的基础 URL —— WB 通过该 URL 拉取生成的图片做 media/save
# 本地开发可留空（会用直接文件上传 fallback）；部署后填公网域名
PUBLIC_BASE_URL=
